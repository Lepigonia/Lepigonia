# Newsletter
NEWSLETTER_PROVIDER_URL=
NEWSLETTER_API_KEY=

# Lepigonia Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-long-random-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

# Content repository (posts only; images are stored in Vercel Blob)
GITHUB_TOKEN=github-token-with-repository-contents-write-access
GITHUB_OWNER=Lepigonia
GITHUB_REPO=Lepigonia
GITHUB_BRANCH=main

# Vercel Blob / Neon Postgres
# In Vercel these are normally injected automatically when the stores are connected.
BLOB_READ_WRITE_TOKEN=
DATABASE_URL=
