# Newsletter (double opt-in): confirmation mails are sent via Resend (https://resend.com).
# The sender must belong to a domain verified in Resend, e.g. "Lepigonia <newsletter@example.com>".
# Without RESEND_API_KEY and NEWSLETTER_FROM the signup answers with 503 instead of storing unconfirmed addresses.
RESEND_API_KEY=
NEWSLETTER_FROM=Lepigonia <newsletter@example.com>
# Public base URL used in confirmation and unsubscribe links (no trailing slash).
SITE_URL=https://lepigonia.vercel.app
# Optional: dedicated secret for unsubscribe links (falls back to ADMIN_SESSION_SECRET).
# Do not change it once newsletters were sent - old unsubscribe links would stop working.
NEWSLETTER_TOKEN_SECRET=
# Original placeholders (not used by the code that was reviewed)
NEWSLETTER_PROVIDER_URL=
NEWSLETTER_API_KEY=

# Lepigonia Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-long-random-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret
# Optional but recommended: second factor (TOTP, works with any authenticator app).
# Generate a secret with: npm run totp:generate
ADMIN_TOTP_SECRET=

# Content repository (posts only; images are stored in Vercel Blob)
# Use a fine-grained personal access token limited to THIS repository with
# "Contents: Read and write" and no other permissions.
GITHUB_TOKEN=github-fine-grained-token-contents-read-write-for-this-repo-only
GITHUB_OWNER=Lepigonia
GITHUB_REPO=Lepigonia
GITHUB_BRANCH=main

# Vercel Blob / Neon Postgres
# In Vercel these are normally injected automatically when the stores are connected.
BLOB_READ_WRITE_TOKEN=
DATABASE_URL=

# Analytics (Umami Cloud)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_API_KEY=

# Optional: set to 1 to send the Content-Security-Policy as report-only while testing a deployment.
# (Read at build time - redeploy after changing it.)
CSP_REPORT_ONLY=